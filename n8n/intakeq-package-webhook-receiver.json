{
  "name": "IntakeQ package webhook receiver (DRAFT, inactive)",
  "active": false,
  "settings": {"executionOrder": "v1", "saveDataSuccessExecution": "none", "saveDataErrorExecution": "all", "saveManualExecutions": false},
  "nodes": [
    {
      "id": "1", "name": "IntakeQ Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0],
      "webhookId": "intakeq-packages",
      "parameters": {
        "httpMethod": "POST",
        "path": "intakeq/REPLACE_WITH_LONG_RANDOM_SECRET",
        "responseMode": "onReceived",
        "responseCode": 200,
        "options": {"rawBody": false}
      },
      "notes": "IntakeQ cannot send custom headers, so the secret is the URL path segment. Generate with: openssl rand -hex 32. Paste the full URL into PracticeQ > More > Settings > Integrations > Developer API > Webhook URL only after activation is approved."
    },
    {
      "id": "2", "name": "Is appointment event?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [260, 0],
      "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"},
        "conditions": [{"id": "c1", "leftValue": "={{ $json.body.EventType }}", "rightValue": "^Appointment", "operator": {"type": "string", "operation": "regex"}}],
        "combinator": "and"}}
    },
    {
      "id": "3", "name": "GET /appointments/{id}", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [520, -120],
      "parameters": {
        "method": "GET",
        "url": "=https://intakeq.com/api/v1/appointments/{{ $json.body.Appointment.Id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {"timeout": 20000, "batching": {"batch": {"batchSize": 1, "batchInterval": 8000}}}
      },
      "credentials": {"httpHeaderAuth": {"name": "IntakeQ API (X-Auth-Key)"}},
      "notes": "Create a Header Auth credential named exactly 'IntakeQ API (X-Auth-Key)' with Name=X-Auth-Key and Value=<the API key>. The webhook payload may omit AppointmentPackageId/Name; the single-appointment endpoint always has them. batchInterval 8000 ms keeps this under 8 req/min."
    },
    {
      "id": "4", "name": "Normalize appointment event", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [780, -120],
      "parameters": {"mode": "manual", "includeOtherFields": false, "assignments": {"assignments": [
        {"id": "a1", "name": "kind", "type": "string", "value": "package_appointment"},
        {"id": "a2", "name": "event", "type": "string", "value": "={{ $('IntakeQ Webhook').item.json.body.EventType }}"},
        {"id": "a3", "name": "appointment_id", "type": "string", "value": "={{ $json.Id }}"},
        {"id": "a4", "name": "client_id", "type": "number", "value": "={{ $json.ClientId }}"},
        {"id": "a5", "name": "package_instance_id", "type": "string", "value": "={{ $json.AppointmentPackageId }}"},
        {"id": "a6", "name": "package_name", "type": "string", "value": "={{ $json.AppointmentPackageName }}"},
        {"id": "a7", "name": "status", "type": "string", "value": "={{ $json.Status }}"},
        {"id": "a8", "name": "start_ms", "type": "number", "value": "={{ $json.StartDate }}"},
        {"id": "a9", "name": "invoice_id", "type": "string", "value": "={{ $json.InvoiceId }}"},
        {"id": "a10", "name": "received_at", "type": "string", "value": "={{ $now.toISO() }}"},
        {"id": "a11", "name": "raw_appointment", "type": "string", "value": "={{ JSON.stringify($json) }}"}
      ]}}
    },
    {
      "id": "5", "name": "Package linked?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1040, -120],
      "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"},
        "conditions": [{"id": "c2", "leftValue": "={{ $json.package_instance_id }}", "rightValue": "", "operator": {"type": "string", "operation": "notEmpty", "singleValue": true}}],
        "combinator": "and"}}
    },
    {
      "id": "6", "name": "Append event file", "type": "n8n-nodes-base.convertToFile", "typeVersion": 1.1, "position": [1300, -200],
      "parameters": {"operation": "toJson", "mode": "each", "options": {"fileName": "={{ $json.received_at.replace(/[:.]/g,'-') }}_{{ $json.appointment_id }}.json"}},
      "notes": "One small JSON file per event. The nightly job drains this folder. If your n8n version has Data Tables, replace nodes 6+7 with a Data Table 'insert' into table intakeq_package_events (same fields)."
    },
    {
      "id": "7", "name": "Write to events folder", "type": "n8n-nodes-base.readWriteFile", "typeVersion": 1, "position": [1560, -200],
      "parameters": {"operation": "write", "fileName": "=/home/node/.n8n-files/intakeq/events/{{ $binary.data.fileName }}", "options": {"append": false}},
      "notes": "Path is inside the n8n container's persistent volume. Create /home/node/.n8n-files/intakeq/events and set N8N_RESTRICT_FILE_ACCESS_TO=/home/node/.n8n-files if file access is restricted."
    },
    {
      "id": "8", "name": "Is invoice event?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [520, 160],
      "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"},
        "conditions": [{"id": "c3", "leftValue": "={{ $json.body.EventType }}", "rightValue": "^Invoice", "operator": {"type": "string", "operation": "regex"}}],
        "combinator": "and"}}
    },
    {
      "id": "9", "name": "Normalize invoice event", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [780, 160],
      "parameters": {"mode": "manual", "includeOtherFields": false, "assignments": {"assignments": [
        {"id": "b1", "name": "kind", "type": "string", "value": "package_invoice"},
        {"id": "b2", "name": "event", "type": "string", "value": "={{ $json.body.EventType }}"},
        {"id": "b3", "name": "client_id", "type": "number", "value": "={{ $json.body.Invoice.ClientIdNumber }}"},
        {"id": "b4", "name": "invoice_id", "type": "string", "value": "={{ $json.body.Invoice.Id }}"},
        {"id": "b5", "name": "invoice_number", "type": "number", "value": "={{ $json.body.Invoice.Number }}"},
        {"id": "b6", "name": "invoice_status", "type": "string", "value": "={{ $json.body.Invoice.Status }}"},
        {"id": "b7", "name": "item_descriptions", "type": "string", "value": "={{ ($json.body.Invoice.Items || []).map(i => i.Description).join(' | ') }}"},
        {"id": "b8", "name": "received_at", "type": "string", "value": "={{ $now.toISO() }}"},
        {"id": "b9", "name": "raw_invoice", "type": "string", "value": "={{ JSON.stringify($json.body.Invoice) }}"}
      ]}}
    }
  ],
  "connections": {
    "IntakeQ Webhook": {"main": [[{"node": "Is appointment event?", "type": "main", "index": 0}]]},
    "Is appointment event?": {"main": [[{"node": "GET /appointments/{id}", "type": "main", "index": 0}], [{"node": "Is invoice event?", "type": "main", "index": 0}]]},
    "GET /appointments/{id}": {"main": [[{"node": "Normalize appointment event", "type": "main", "index": 0}]]},
    "Normalize appointment event": {"main": [[{"node": "Package linked?", "type": "main", "index": 0}]]},
    "Package linked?": {"main": [[{"node": "Append event file", "type": "main", "index": 0}], []]},
    "Append event file": {"main": [[{"node": "Write to events folder", "type": "main", "index": 0}]]},
    "Is invoice event?": {"main": [[{"node": "Normalize invoice event", "type": "main", "index": 0}], []]},
    "Normalize invoice event": {"main": [[{"node": "Append event file", "type": "main", "index": 0}]]}
  }
}
