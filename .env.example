# Copy to .env (never commit .env). Key lives at More > Settings > Integrations > Developer API in PracticeQ.
INTAKEQ_API_KEY=your-key-here
# Standard plan is 10 requests/minute; 6s between calls stays under it. Lower if PracticeQ raised your limit.
INTAKEQ_MIN_SECONDS_BETWEEN_CALLS=6

# ---- lead_agent (after-hours / busy-hours lead follow-up) ----
ANTHROPIC_API_KEY=sk-ant-...
GHL_TOKEN=pit-...                      # Private Integration token for the sub-account
GHL_LOCATION_ID=GZecKV1IvZgcZdeVItxt
GHL_CALENDAR_ID=cEAl8rVZptX0GMvhT4gH   # inquiry-call calendar
GHL_SMS_FROM_NUMBER=                   # optional: +1... number to text from (defaults to location default)
GHL_WEBHOOK_SECRET=                    # openssl rand -hex 24; part of the webhook URL
ADMIN_SECRET=                          # openssl rand -hex 24; /admin/<secret>/...
RETELL_API_KEY=
RETELL_AGENT_ID=                       # printed by: python3 -m lead_agent setup-voice
RETELL_FROM_NUMBER=+1...
PUBLIC_BASE_URL=https://leads.example.com
LEAD_AGENT_DB=/data/lead_agent.sqlite3
LEAD_AGENT_DRY_RUN=0                   # 1 = decide and draft, but never send/call/book

# ---- superbill (automatic superbills into PracticeQ client files) ----
# INTAKEQ_API_KEY above is reused; set INTAKEQ_MIN_SECONDS_BETWEEN_CALLS=3.2 on the 20 req/min tier.
SUPERBILL_SECRET=                      # openssl rand -hex 24; header X-Superbill-Secret for /sync, /rebuild, /webhook
SUPERBILL_CONFIG=superbill_config.json # practice, provider, CPT defaults, file naming
